# local .terraform directories and plugins
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# crash log files
crash.log
crash.*.log

# exclude all .tfvars files
*.tfvars
*.tfvars.json

# ignore override files used for local testing
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ignore CLI configuration files
.terraformrc
terraform.rc

# ignore lock files
.terraform.lock.hcl
